# MediFlow AI Backend Environment Configuration
# Target: AMD Developer Cloud (ROCm 6.x + local vLLM on port 8000)

# Application Server Settings
ENVIRONMENT=production
DEBUG=false
PROJECT_NAME="MediFlow AI"
API_V1_STR="/api/v1"
HOST="0.0.0.0"
PORT=8080 # Distinct port 8080 prevents collision with local vLLM on port 8000
SECRET_KEY="generate-a-secure-random-secret-key-for-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AMD ROCm vLLM Local Engine
# NOTE: Points directly to local AMD ROCm vLLM instance on port 8000; strictly guarantees zero PHI leakage.
VLLM_BASE_URL="http://127.0.0.1:8000/v1"
VLLM_MODEL_NAME="Qwen/Qwen2.5-7B-Instruct"
VLLM_EMBEDDING_MODEL_NAME="BAAI/bge-small-en-v1.5"
VLLM_API_KEY="local-amdsmi-auth-not-required"
VLLM_TIMEOUT_SECONDS=60.0
VLLM_MAX_TOKENS=2048
VLLM_TEMPERATURE=0.1

# AMD ROCm Hardware Telemetry & Architecture Settings
# Leave HSA_OVERRIDE_GFX_VERSION empty on AMD Instinct MI210/MI250/MI300 (gfx90a/gfx940/gfx942).
# Only set (e.g., 11.0.0) if running on consumer Radeon RDNA3 hardware requiring manual override.
HSA_OVERRIDE_GFX_VERSION=""
ROCM_PATH="/opt/rocm"
HIP_VISIBLE_DEVICES="0"

# PostgreSQL 16 + pgvector Clinical Database
DATABASE_URL="postgresql+asyncpg://mediflow_user:mediflow_password@127.0.0.1:5432/mediflow_db"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# OCR Configuration
OCR_ENGINE="auto" # Options: "paddleocr", "tesseract", "auto"
OCR_LANGUAGES="en,ur"
OCR_CONFIDENCE_THRESHOLD=0.75

# Clinical Guardrails & Thresholds
TIER3_RED_FLAG_THRESHOLD=0.90
EMERGENCY_CONTACT_NUMBER="1122" # Pakistan National Rescue / Emergency Service
EMERGENCY_ALT_CONTACT="911"

# Storage Settings
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=15

# Security, CORS & PHI Encryption
# Supports JSON list syntax or comma-separated strings
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://localhost:8080"
PHI_ENCRYPTION_KEY="mediflow-phi-32byte-aes-secret-key!"
